{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "skipLibCheck": true
  },
  "include": ["src"],
  // Tests are source, not product — without this they compile into dist and
  // ship to every consumer, dragging a vitest import along with them.
  "exclude": ["src/**/*.test.ts"]
}
